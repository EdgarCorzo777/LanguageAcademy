# Google Gemini Configuration (Recommended - Free Tier Available)
GOOGLE_API_KEY=your_gemini_api_key_from_google_ai_studio
GEMINI_MODEL_NAME=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# OpenAI Configuration (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-3.5-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Active LLM Provider: 'gemini' or 'openai' (auto-detected if key is set)
LLM_PROVIDER=gemini

# Telegram Bot Configuration (From @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
VECTOR_DB_DIR=./chroma_db
SIMILARITY_THRESHOLD=0.65
HUMAN_SUPPORT_EMAIL=admissions-support@techuniversity.edu
HUMAN_SUPPORT_PHONE=+1 (800) 555-0199
