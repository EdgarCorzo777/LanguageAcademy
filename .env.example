# ==============================================================
# Language Academy Admissions Assistant - Environment Config
# ==============================================================

# Google Gemini Configuration (Recommended - Free & Fast)
GOOGLE_API_KEY=your_gemini_api_key_from_google_ai_studio
GEMINI_MODEL_NAME=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# OpenAI Configuration (Optional Fallback)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-3.5-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Active LLM Provider: 'gemini' or 'openai' (auto-detected if key is set)
LLM_PROVIDER=gemini

# Application Server Settings (Web Form & REST API)
APP_HOST=0.0.0.0
APP_PORT=8000
VECTOR_DB_DIR=./chroma_db
SIMILARITY_THRESHOLD=0.65
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Response Cache Settings (Reduces LLM API Cost & Latency)
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_SECONDS=86400

# Language Academy & Human Support Contact Details
ACADEMY_NAME=Language Academy
HUMAN_SUPPORT_EMAIL=admisiones@languageacademy.edu.co
HUMAN_SUPPORT_PHONE=+57 (300) 123-4567
HUMAN_SUPPORT_HOURS=Monday - Friday, 8:00 AM - 6:00 PM; Saturday, 8:00 AM - 1:00 PM (COT / UTC-5)
